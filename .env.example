GROQ_API_KEY=your_groq_key_here
DATABASE_URL=postgresql://localhost/rag_agent

# --- переключатель бэкенда эмбеддингов/реранкинга, см. src/config.py ---
# false (дефолт) = self-hosted sentence-transformers, локально
# true            = Cohere API — используется в деплое на Render (память)
USE_COHERE=false
COHERE_API_KEY=

# --- только для деплоя: домен фронта, для CORS в src/api.py ---
ALLOWED_ORIGIN=
